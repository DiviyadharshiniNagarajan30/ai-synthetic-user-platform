# Copy to backend/.env and edit. Never commit the real .env.
# XAMPP MySQL is usually port 3306; if you changed it (e.g. 3307) use that port here.
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/synthetic_user_db
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=180
# Comma separated list of browser origins allowed to call the API
FRONTEND_ORIGIN=http://localhost:5500
MAX_PERSONAS_PER_REQUEST=20
